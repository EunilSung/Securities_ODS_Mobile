CREATE TABLE WatchStockEntity (
    code TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    market TEXT NOT NULL,
    price INTEGER NOT NULL,
    previousClose INTEGER NOT NULL,
    volume INTEGER NOT NULL,
    sortOrder INTEGER NOT NULL
);

selectWatchlist:
SELECT * FROM WatchStockEntity ORDER BY sortOrder;

selectStock:
SELECT * FROM WatchStockEntity WHERE code = ?;

insertStockIfAbsent:
INSERT OR IGNORE INTO WatchStockEntity VALUES ?;

updateQuote:
UPDATE WatchStockEntity SET price = ?, volume = ? WHERE code = ?;

CREATE TABLE CustomerEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    birthDate TEXT NOT NULL,
    gender TEXT NOT NULL,
    phone TEXT NOT NULL,
    address TEXT NOT NULL,
    grade TEXT NOT NULL,
    riskProfile TEXT,
    riskAssessedAt INTEGER,
    registeredAt INTEGER NOT NULL
);

selectCustomers:
SELECT * FROM CustomerEntity ORDER BY name;

selectCustomer:
SELECT * FROM CustomerEntity WHERE id = ?;

countCustomers:
SELECT COUNT(*) FROM CustomerEntity;

insertCustomer:
INSERT INTO CustomerEntity VALUES ?;

updateRiskProfile:
UPDATE CustomerEntity SET riskProfile = ?, riskAssessedAt = ? WHERE id = ?;

CREATE TABLE ConsultationEntity (
    id TEXT NOT NULL PRIMARY KEY,
    customerId TEXT NOT NULL,
    consultedAt INTEGER NOT NULL,
    channel TEXT NOT NULL,
    topic TEXT NOT NULL,
    content TEXT NOT NULL,
    staffName TEXT NOT NULL
);

CREATE INDEX ConsultationEntity_customer ON ConsultationEntity(customerId, consultedAt);

selectConsultations:
SELECT * FROM ConsultationEntity WHERE customerId = ? ORDER BY consultedAt DESC;

insertConsultation:
INSERT INTO ConsultationEntity VALUES ?;

CREATE TABLE AccountEntity (
    accountNo TEXT NOT NULL PRIMARY KEY,
    customerId TEXT NOT NULL,
    type TEXT NOT NULL,
    openedAt INTEGER NOT NULL
);

CREATE INDEX AccountEntity_customer ON AccountEntity(customerId);

selectAccounts:
SELECT * FROM AccountEntity WHERE customerId = ? ORDER BY openedAt;

insertAccount:
INSERT INTO AccountEntity VALUES ?;

CREATE TABLE VisitEntity (
    id TEXT NOT NULL PRIMARY KEY,
    customerId TEXT NOT NULL,
    scheduledAt INTEGER NOT NULL,
    place TEXT NOT NULL,
    purpose TEXT NOT NULL,
    memo TEXT NOT NULL,
    status TEXT NOT NULL
);

CREATE INDEX VisitEntity_time ON VisitEntity(scheduledAt);

selectVisitsBetween:
SELECT v.id, v.customerId, COALESCE(c.name, '') AS customerName, v.scheduledAt, v.place, v.purpose, v.memo, v.status
FROM VisitEntity v
LEFT JOIN CustomerEntity c ON c.id = v.customerId
WHERE v.scheduledAt >= :fromMillis AND v.scheduledAt < :untilMillis
ORDER BY v.scheduledAt;

selectVisit:
SELECT v.id, v.customerId, COALESCE(c.name, '') AS customerName, v.scheduledAt, v.place, v.purpose, v.memo, v.status
FROM VisitEntity v
LEFT JOIN CustomerEntity c ON c.id = v.customerId
WHERE v.id = ?;

selectUpcomingVisits:
SELECT v.id, v.customerId, COALESCE(c.name, '') AS customerName, v.scheduledAt, v.place, v.purpose, v.memo, v.status
FROM VisitEntity v
LEFT JOIN CustomerEntity c ON c.id = v.customerId
WHERE v.customerId = :customerId AND v.status = 'SCHEDULED' AND v.scheduledAt >= :fromMillis
ORDER BY v.scheduledAt;

countVisits:
SELECT COUNT(*) FROM VisitEntity;

insertVisit:
INSERT INTO VisitEntity VALUES ?;

updateVisitStatus:
UPDATE VisitEntity SET status = ? WHERE id = ?;

wipeBusinessData {
    DELETE FROM WatchStockEntity;
    DELETE FROM CustomerEntity;
    DELETE FROM ConsultationEntity;
    DELETE FROM AccountEntity;
    DELETE FROM VisitEntity;
}
