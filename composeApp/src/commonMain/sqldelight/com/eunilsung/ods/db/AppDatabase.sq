CREATE TABLE WatchStockEntity (
    code TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    market TEXT NOT NULL,
    price INTEGER NOT NULL,
    previousClose INTEGER NOT NULL,
    volume INTEGER NOT NULL,
    sortOrder INTEGER NOT NULL
);

selectWatchlist:
SELECT * FROM WatchStockEntity ORDER BY sortOrder;

selectStock:
SELECT * FROM WatchStockEntity WHERE code = ?;

insertStockIfAbsent:
INSERT OR IGNORE INTO WatchStockEntity VALUES ?;

updateQuote:
UPDATE WatchStockEntity SET price = ?, volume = ? WHERE code = ?;

CREATE TABLE HoldingEntity (
    code TEXT NOT NULL PRIMARY KEY,
    quantity INTEGER NOT NULL,
    averagePrice INTEGER NOT NULL
);

insertHoldingIfAbsent:
INSERT OR IGNORE INTO HoldingEntity VALUES ?;

selectHoldingQuantity:
SELECT quantity FROM HoldingEntity WHERE code = ?;

selectHoldings:
SELECT
    h.code,
    COALESCE(w.name, h.code) AS name,
    h.quantity,
    h.averagePrice,
    COALESCE(w.price, h.averagePrice) AS price,
    COALESCE(w.previousClose, h.averagePrice) AS previousClose,
    CAST((SELECT COALESCE(SUM(o.quantity), 0) FROM OpenOrderEntity o WHERE o.code = h.code AND o.side = 'SELL') AS INTEGER) AS openSellQuantity
FROM HoldingEntity h
LEFT JOIN WatchStockEntity w ON w.code = h.code
ORDER BY COALESCE(w.sortOrder, 9999), h.code;

CREATE TABLE OpenOrderEntity (
    orderNo TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    name TEXT NOT NULL,
    side TEXT NOT NULL,
    type TEXT NOT NULL,
    price INTEGER NOT NULL,
    quantity INTEGER NOT NULL,
    reservedAmount INTEGER NOT NULL,
    acceptedAt INTEGER NOT NULL,
    originalOrderNo TEXT
);

CREATE INDEX OpenOrderEntity_code_side ON OpenOrderEntity(code, side);

insertOpenOrder:
INSERT INTO OpenOrderEntity VALUES ?;

selectOpenOrders:
SELECT * FROM OpenOrderEntity ORDER BY acceptedAt DESC, orderNo DESC;

selectOpenOrder:
SELECT * FROM OpenOrderEntity WHERE orderNo = ?;

deleteOpenOrder:
DELETE FROM OpenOrderEntity WHERE orderNo = ?;

countOpenOrders:
SELECT COUNT(*) FROM OpenOrderEntity;

CREATE TABLE OrderNumberEntity (
    number INTEGER PRIMARY KEY AUTOINCREMENT,
    issuedAt INTEGER NOT NULL
);

insertOrderNumber:
INSERT INTO OrderNumberEntity(issuedAt) VALUES (?);

lastOrderNumber:
SELECT last_insert_rowid();

sumReservedBuyAmount:
SELECT CAST(COALESCE(SUM(reservedAmount), 0) AS INTEGER) FROM OpenOrderEntity WHERE side = 'BUY';

sumOpenSellQuantity:
SELECT CAST(COALESCE(SUM(quantity), 0) AS INTEGER) FROM OpenOrderEntity WHERE code = ? AND side = 'SELL';
